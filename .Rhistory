#Simple Linear Regression
#Create Dataset
data <- data.frame(
Hours = c(1, 2, 3, 4, 5),
Marks = c(35, 47, 59, 67, 74)
)
#Display Dataset
print(data)
#Linear Regression Model
model <- lm(Marks ~ Hours, data = data)
#Summary of Model
summary(model)
#Regression Coefficients
print(coef(model))
